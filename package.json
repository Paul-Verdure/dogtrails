{
	"name": "dogtrails",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p scripts && node scripts/check-tokens.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"prebuild": "npm run validate",
		"data:extract": "node scripts/extract-parker.ts",
		"data:tree": "node scripts/parse-tree.ts",
		"data:fci": "node scripts/fetch-fci.ts",
		"data:wikidata": "node scripts/fetch-wikidata.ts",
		"data:names-report": "node scripts/report-names.ts",
		"data:merge": "node scripts/merge-fci.ts",
		"validate": "node scripts/validate.ts",
		"maps": "node scripts/make-maps.ts",
		"data:credits": "node scripts/fetch-credits.ts",
		"data:review": "node scripts/report-review.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/d3-geo": "^3.1.1",
		"@types/d3-hierarchy": "^3.1.7",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^26.6.6",
		"@types/topojson-client": "^3.1.5",
		"fflate": "^0.8.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"topojson-client": "^3.1.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"world-atlas": "^2.0.2"
	},
	"dependencies": {
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource/instrument-serif": "^5.3.0",
		"d3-geo": "^3.1.2",
		"d3-hierarchy": "^3.1.3",
		"d3-shape": "^3.2.1",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=22.18"
	}
}
